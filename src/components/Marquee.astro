---
import Icon from './Icon.astro';
const words = ['Nail design', 'Lash design', 'Sobrancelha', 'Maquiagem', 'Esmaltes em gel', 'Cílios', 'Depilação', 'Acessórios', 'Joias em aço', 'Decoração festiva'];
---
<div class="mq" aria-label="Categorias da loja">
  <div class="track">
    {[0, 1].map((k) => (
      <ul aria-hidden={k === 1 ? 'true' : undefined}>
        {words.map((w) => <li><span class="display">{w}</span><Icon name="spark" /></li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .mq { background: var(--ink); color: #fff; overflow: hidden; padding: 20px 0; }
  .track { display: flex; width: max-content; animation: slide 46s linear infinite; }
  .mq:hover .track { animation-play-state: paused; }
  ul { display: flex; flex: none; }
  li { display: flex; align-items: center; gap: 28px; padding-right: 28px; white-space: nowrap; }
  li span { font-size: clamp(1.3rem, 2.3vw, 1.9rem); letter-spacing: 0.04em; text-transform: uppercase; }
  li :global(svg) { width: 16px; height: 16px; color: var(--pink); }
  @keyframes slide { to { transform: translateX(-50%); } }
</style>
