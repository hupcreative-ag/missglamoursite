---
/**
 * Selo de entrega rápida: adesivo rosa brilhante com texto girando em volta
 * e uma caixa 3D (isométrica, com fita rosa) saindo em disparada no centro.
 * Tudo em SVG: nítido em qualquer tela e leve.
 */
interface Props { class?: string }
const { class: cls } = Astro.props;
const ring = 'ENTREGA RÁPIDA EM SALVADOR ✦ PEDIU ATÉ 10H ✦ ';
---
<div class:list={['badge', cls]} role="img" aria-label="Pediu até 10h, chega hoje. Entrega rápida em Salvador.">
  <svg viewBox="-4 -4 208 212" aria-hidden="true">
    <defs>
      <radialGradient id="db-pink" cx="35%" cy="28%" r="80%">
        <stop offset="0" stop-color="#f6a3c0" />
        <stop offset="0.55" stop-color="#e2668f" />
        <stop offset="1" stop-color="#c2477a" />
      </radialGradient>
      <linearGradient id="db-top" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#e6f8fb" />
        <stop offset="1" stop-color="#b4e3ec" />
      </linearGradient>
      <linearGradient id="db-left" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#8fd0dd" />
        <stop offset="1" stop-color="#5aaebf" />
      </linearGradient>
      <linearGradient id="db-right" x1="1" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#a6dce7" />
        <stop offset="1" stop-color="#76c1d0" />
      </linearGradient>
      <path id="db-ring" d="M100,100 m-79,0 a79,79 0 1,1 158,0 a79,79 0 1,1 -158,0" />
    </defs>

    <!-- adesivo com borda recortada -->
    <g class="sticker-body">
      <circle cx="100" cy="104" r="98" fill="rgba(120,30,70,0.18)" />
      <circle cx="100" cy="100" r="98" fill="#fff" />
      <circle cx="100" cy="100" r="92" fill="url(#db-pink)" />
      <ellipse cx="72" cy="46" rx="44" ry="18" fill="#fff" opacity="0.22" transform="rotate(-28 72 46)" />
    </g>

    <!-- texto girando -->
    <g class="spin">
      <text font-family="Jost Variable, Jost, sans-serif" font-weight="800" font-size="14" fill="#fff" letter-spacing="0.5"><textPath href="#db-ring" textLength="492" lengthAdjust="spacing">{ring}</textPath></text>
    </g>

    <!-- miolo branco com a caixa 3D -->
    <circle cx="100" cy="100" r="63" fill="#fff" />
    <g transform="translate(100 64) scale(0.46) translate(-92 -108)"><g class="box">
      <ellipse cx="104" cy="140" rx="30" ry="6" fill="rgba(32,35,40,0.12)" />
      <!-- linhas de velocidade -->
      <g stroke-linecap="round" stroke-width="5">
        <line x1="50" y1="98" x2="64" y2="98" stroke="#e2668f" />
        <line x1="44" y1="111" x2="64" y2="111" stroke="#97d3e0" />
        <line x1="52" y1="124" x2="66" y2="124" stroke="#e2668f" opacity="0.6" />
      </g>
      <polygon points="76,90 104,104 104,136 76,122" fill="url(#db-left)" />
      <polygon points="104,104 132,90 132,122 104,136" fill="url(#db-right)" />
      <polygon points="104,76 132,90 104,104 76,90" fill="url(#db-top)" />
      <!-- fita rosa -->
      <polygon points="87.3,81.7 92.7,84.3 120.7,98.3 115.3,95.7" fill="#f08cae" />
      <polygon points="115.3,95.7 120.7,98.3 120.7,130.3 115.3,127.7" fill="#d4567f" />
      <!-- brilho nas arestas -->
      <polyline points="76,90 104,76 132,90" fill="none" stroke="#fff" stroke-width="1.6" opacity="0.9" stroke-linejoin="round" />
      <line x1="104" y1="104" x2="104" y2="136" stroke="#fff" stroke-width="1.2" opacity="0.55" />
    </g></g>
    <text font-family="Jost Variable, Jost, sans-serif" font-weight="800" font-size="23" fill="#3f454d" x="100" y="108" text-anchor="middle">CHEGA</text>
    <text font-family="Jost Variable, Jost, sans-serif" font-weight="800" font-size="23" fill="#3f454d" x="100" y="130" text-anchor="middle">HOJE!</text>
    <text font-family="Belleza, sans-serif" font-size="11.5" fill="#202328" letter-spacing="0.6" x="100" y="147" text-anchor="middle">PEDIU ATÉ 10H</text>
    <line x1="72" y1="151" x2="128" y2="151" stroke="#202328" stroke-width="1" />

  </svg>
</div>

<style>
  .badge { width: 100%; aspect-ratio: 1; }
  svg { width: 100%; height: 100%; overflow: visible; }
  .ring-text { font-family: var(--sans); font-weight: 800; font-size: 14px; fill: #fff; letter-spacing: 0.04em; }
  .big { font-family: var(--sans); font-weight: 800; font-size: 22px; fill: #3f454d; letter-spacing: 0.01em; }
  .small { font-family: var(--display); font-size: 11px; fill: #202328; letter-spacing: 0.06em; }
  .spin { transform-origin: 100px 100px; animation: spin 26s linear infinite; }
  .box { animation: zoom 2.8s var(--ease-in-out) infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes zoom { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(3px, -3px); } }
  @media (prefers-reduced-motion: reduce) { .spin, .box { animation: none; } }
</style>
