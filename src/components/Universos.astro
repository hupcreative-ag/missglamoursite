---
import Icon from './Icon.astro';
import { wa } from '../config/site';
import { categories } from '../config/media';
---
<section id="tudo" class="uni">
  <div class="wrap">
    <div class="head">
      <h2 class="display h2">Tem pra você também</h2>
      <p class="lead">Chega novidade toda semana. Viu no TikTok? Pergunta que a gente tem.</p>
    </div>

    <ul class="grid" data-reveal>
      {categories.map((c, i) => (
        <li data-reveal-item>
          <a class="cat" href={c.href ?? wa(`Oi, Miss! Quero ver ${c.ask ?? c.title.toLowerCase()}.`)} target={c.href ? undefined : '_blank'} rel={c.href ? undefined : 'noopener'}>
            <span class:list={['ph', i % 2 ? 'pink' : 'blue']}><img src={c.img} alt={c.alt} loading="lazy" width="400" height="400" /></span>
            <span class="lbl">{c.title}{c.brands && <small>{c.brands}</small>}</span>
          </a>
        </li>
      ))}
      <li data-reveal-item>
        <a class="cat ask" href={wa('Oi, Miss! Quero saber se vocês têm este produto: ')} target="_blank" rel="noopener">
          <span class="ph ask-ph"><Icon name="whatsapp" /><span>Perguntar se tem</span></span>
          <span class="lbl">Não achou?</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .uni { padding: var(--sec-y) 0; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 32px; align-items: end; margin-bottom: var(--head-gap); }
  .head .lead { justify-self: end; }

  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .cat { display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: var(--ink); }
  .ph { position: relative; display: block; aspect-ratio: 1; border-radius: 16px; overflow: hidden; }
  .ph.blue { background: var(--blue-soft); }
  .ph.pink { background: var(--pink-soft); }
  .ph img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease-out); }
  .cat:hover .ph img { transform: scale(1.06) rotate(-1.5deg); }
  .lbl { font-weight: 500; font-size: 0.98rem; line-height: 1.25; }
  .lbl small { display: block; margin-top: 2px; font-weight: 400; font-size: 0.82em; color: var(--ink-3); }
  .ask-ph { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; background: var(--ink); color: #fff; font-weight: 500; font-size: 0.95rem; text-align: center; padding: 12px; transition: background 0.3s; }
  .ask-ph :global(svg) { width: 30px; height: 30px; color: #3fd17a; }
  .ask:hover .ask-ph { background: var(--pink-ink); }

  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; }
    .head .lead { justify-self: start; }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px 10px; }
    .ph { border-radius: 12px; }
    .lbl { font-size: 0.875rem; }
    .ask-ph { font-size: 0.8rem; }
    .ask-ph :global(svg) { width: 24px; height: 24px; }
  }
</style>
