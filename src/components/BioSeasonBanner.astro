---
/**
 * Banner decorativo da campanha na página de links (/links).
 * Conteúdo: season.bio (ou, se faltar, o bloco `feature` da campanha).
 * Decoração escolhida pelo season.theme: natal · sao-joao · carnaval · halloween (outro = brilhos).
 */
import Icon from './Icon.astro';
import type { Season, Catalog } from '../seasons/types';

interface Props { season: Season; catalog: Catalog }
const { season, catalog } = Astro.props;

const total = catalog.categories.reduce((n, c) => n + c.products.length, 0);
const b = season.bio ?? {
  kicker: `Catálogo ${season.name}`,
  title: season.feature.title,
  text: season.feature.lead,
  cta: 'Ver catálogo',
  image: undefined,
  imageAlt: undefined,
};
const theme = ['natal', 'sao-joao', 'carnaval', 'halloween'].includes(season.theme) ? season.theme : 'generic';

// gerador fixo (mesmo desenho a cada build)
let seed = 11;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);

// fio em "barriguinhas": usado pelo pisca-pisca (natal) e pelas bandeirinhas (são joão)
const W = 400;
function swags(span: number, sag: number, per: number) {
  const parts: string[] = [];
  const pts: { x: number; y: number; t: number }[] = [];
  for (let x0 = -span / 2, k = 0; x0 < W + span; x0 += span, k++) {
    const x1 = x0 + span;
    const y0 = 4;
    parts.push(`${k ? '' : `M${x0} ${y0} `}Q${x0 + span / 2} ${y0 + sag * 2} ${x1} ${y0}`);
    for (let i = 1; i <= per; i++) {
      const t = i / (per + 1);
      pts.push({
        x: (1 - t) * (1 - t) * x0 + 2 * (1 - t) * t * (x0 + span / 2) + t * t * x1,
        y: (1 - t) * (1 - t) * y0 + 2 * (1 - t) * t * (y0 + sag * 2) + t * t * y0,
        t,
      });
    }
  }
  return { d: parts.join(' '), pts };
}

const lights = swags(100, 14, 4);
const bulbColors = ['#ffd36b', '#ff3d55', '#36e08a', '#4db8ff', '#ff7ad6'];
const bulbs = lights.pts.map((p, i) => ({
  ...p,
  r: (p.t - 0.5) * 50 + (rnd() - 0.5) * 16,
  c: bulbColors[i % bulbColors.length],
  d: (1.4 + rnd() * 2.2).toFixed(2),
  delay: (-rnd() * 4).toFixed(2),
}));

const flagsLine = swags(130, 10, 6);
const flagColors = ['#ff4d6d', '#ffd23f', '#3bceac', '#4d9de0', '#ff8c42', '#b388eb'];
const flags = flagsLine.pts.map((p, i) => ({ ...p, c: flagColors[i % flagColors.length], sway: (-rnd() * 3).toFixed(2) }));

const confColors = ['#ffe14d', '#3be8d0', '#ff8fd2', '#ffffff', '#8cff6b', '#ff6b4a'];
const confetti = Array.from({ length: 26 }, (_, i) => ({
  x: (rnd() * 100).toFixed(1),
  y: (rnd() * 100).toFixed(1),
  r: Math.round(rnd() * 180),
  c: confColors[i % confColors.length],
  round: rnd() > 0.55,
  delay: (-rnd() * 6).toFixed(2),
}));

const bats = [
  { x: 64, y: 16, s: 1, delay: '0s' },
  { x: 80, y: 30, s: 0.7, delay: '-0.4s' },
  { x: 54, y: 34, s: 0.55, delay: '-0.9s' },
];

const sparkles = Array.from({ length: 10 }, () => ({
  x: (rnd() * 100).toFixed(1),
  y: (rnd() * 60).toFixed(1),
  s: (0.5 + rnd() * 0.9).toFixed(2),
  delay: (-rnd() * 3).toFixed(2),
}));
---
<a class="sb" data-theme={theme} data-photo={b.image ? '' : undefined} href={`/${catalog.slug}`}>
  {b.image && (
    <img class="photo" src={b.image} alt={b.imageAlt ?? ''} width="800" height="540" fetchpriority="high" />
  )}

  {theme === 'natal' && (
    <svg class="decor garland" viewBox="0 0 400 54" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
      <defs><filter id="sb-glow" x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur stdDeviation="4" /></filter></defs>
      <path d={lights.d} fill="none" stroke="#1f3a2c" stroke-width="1.6" stroke-linecap="round" />
      {bulbs.map((p) => (
        <g class="bulb" style={`--c:${p.c};--d:${p.d}s;--delay:${p.delay}s`} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${p.r.toFixed(1)})`}>
          <circle class="halo" cx="0" cy="9" r="10" filter="url(#sb-glow)" />
          <rect class="cap" x="-2.2" y="-0.6" width="4.4" height="4.4" rx="1" />
          <path class="glass" d="M0 3.4C4 4.3 4.6 8.6 3.5 12C2.6 14.5 1.1 16 0 16C-1.1 16 -2.6 14.5 -3.5 12C-4.6 8.6 -4 4.3 0 3.4Z" />
        </g>
      ))}
    </svg>
  )}

  {theme === 'sao-joao' && (
    <svg class="decor flags" viewBox="0 0 400 54" preserveAspectRatio="xMidYMin slice" aria-hidden="true">
      <path d={flagsLine.d} fill="none" stroke="#e9d8b4" stroke-width="1.2" />
      {flags.map((f) => (
        <g transform={`translate(${f.x.toFixed(1)} ${f.y.toFixed(1)})`}>
          <path class="flag" style={`--sway:${f.sway}s`} d="M-7 0H7V17L0 12.5L-7 17Z" fill={f.c} />
        </g>
      ))}
    </svg>
  )}

  {theme === 'carnaval' && (
    <span class="decor confetti" aria-hidden="true">
      {confetti.map((c) => (
        <i class:list={{ round: c.round }} style={`left:${c.x}%;top:${c.y}%;--r:${c.r}deg;--c:${c.c};--delay:${c.delay}s`}></i>
      ))}
      <svg class="streamers" viewBox="0 0 400 60" preserveAspectRatio="none">
        <path d="M-10 18C30 -4 50 40 90 18S150 -4 190 20" stroke="#ffe14d" />
        <path d="M210 8C250 34 280 -6 320 16S380 36 410 10" stroke="#3be8d0" />
        <path d="M120 44C150 24 170 58 205 40" stroke="#ff8fd2" />
      </svg>
    </span>
  )}

  {theme === 'halloween' && (
    <span class="decor spooky" aria-hidden="true">
      <i class="moon"></i>
      <svg class="web" viewBox="0 0 100 100">
        <path d="M0 0L100 58M0 0L72 100M0 0L100 22M0 0L34 100M0 0L100 100" />
        <path d="M0 24Q14 16 20 0M0 46Q28 36 40 0M0 70Q44 56 62 0M0 94Q58 78 84 0" />
      </svg>
      {bats.map((bt) => (
        <svg class="bat" style={`left:${bt.x}%;top:${bt.y}%;--s:${bt.s};--delay:${bt.delay}`} viewBox="0 0 40 18">
          <path d="M20 6c1-2 2-3 2-3l1 3c3-3 8-4 12-2-2 1-3 3-3 5-2-1-4 0-5 2-1-2-3-2-5-1l-2 4-2-4c-2-1-4-1-5 1-1-2-3-3-5-2 0-2-1-4-3-5 4-2 9-1 12 2l1-3s1 1 2 3Z" />
        </svg>
      ))}
    </span>
  )}

  {theme === 'generic' && (
    <span class="decor sparkles" aria-hidden="true">
      {sparkles.map((s) => (
        <svg style={`left:${s.x}%;top:${s.y}%;--s:${s.s};--delay:${s.delay}s`} viewBox="0 0 24 24"><path d="M12 2c.4 4.6 2.4 7.6 8 10-5.6 2.4-7.6 5.4-8 10-.4-4.6-2.4-7.6-8-10 5.6-2.4 7.6-5.4 8-10Z" /></svg>
      ))}
    </span>
  )}

  <span class="body">
    <span class="kicker"><Icon name="spark" />{b.kicker}</span>
    <span class="title display">{b.title}</span>
    <span class="text">{b.text}</span>
    <span class="foot">
      <span class="cta">{b.cta}<Icon name="arrow" /></span>
      <span class="count">{total} peças</span>
    </span>
  </span>
</a>

<style>
  .sb {
    /* cores por tema (padrão = natal) */
    --bg: radial-gradient(120% 90% at 85% 0%, #1b2630 0%, #0c1116 60%) #0c1116;
    --fg: #f3eee6;
    --hi: #ffd79a;
    --cta-bg: #e3bb6a;
    --cta-fg: #0c1116;
    position: relative;
    isolation: isolate;
    display: block;
    overflow: hidden;
    border-radius: 22px;
    background: var(--bg);
    color: var(--fg);
    text-decoration: none;
    box-shadow: 0 18px 44px -20px rgba(12, 17, 22, 0.7);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .sb:hover { transform: translateY(-3px); box-shadow: 0 26px 54px -22px rgba(12, 17, 22, 0.8); }
  .sb:active { transform: scale(0.985); }
  .sb[data-theme='sao-joao'] { --bg: radial-gradient(120% 90% at 80% 0%, #2a3a7a 0%, #141c45 62%) #141c45; --hi: #ffcf5c; --cta-bg: #ffb547; --cta-fg: #141c45; }
  .sb[data-theme='carnaval'] { --bg: linear-gradient(150deg, #6a1fc2 0%, #b4248f 55%, #ff4f7b 100%); --fg: #fff; --hi: #ffe14d; --cta-bg: #ffe14d; --cta-fg: #3a0d6b; }
  .sb[data-theme='halloween'] { --bg: radial-gradient(110% 90% at 85% 0%, #3a1d52 0%, #150b20 60%) #150b20; --hi: #ff9a3d; --cta-bg: #ff7a1a; --cta-fg: #150b20; }
  .sb[data-theme='generic'] { --bg: radial-gradient(120% 90% at 85% 0%, #2c3640 0%, var(--ink) 60%) var(--ink); --hi: var(--blue); --cta-bg: var(--blue); --cta-fg: var(--ink); }

  /* foto no topo, esmaecendo no fundo do card */
  .photo {
    display: block; width: 100%; height: auto; aspect-ratio: 800 / 540; object-fit: cover;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
  }

  .decor { position: absolute; z-index: 2; inset: 0 0 auto; pointer-events: none; }
  svg.decor { width: 100%; height: 54px; }

  .body { position: relative; z-index: 3; display: flex; flex-direction: column; gap: 6px; padding: 72px 22px 22px; }
  .sb[data-photo] .body { margin-top: -84px; padding-top: 0; }
  .kicker { display: inline-flex; align-items: center; gap: 7px; font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--hi); }
  .kicker :global(svg) { width: 14px; height: 14px; }
  .title { font-size: clamp(1.9rem, 8.4vw, 2.3rem); line-height: 1; text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45); }
  .text { font-size: 0.98rem; line-height: 1.4; opacity: 0.84; max-width: 32ch; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
  .cta {
    display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; border-radius: 999px;
    background: var(--cta-bg); color: var(--cta-fg); font-weight: 600; font-size: 1rem;
  }
  .cta :global(svg) { width: 18px; height: 18px; transition: transform 0.4s var(--ease-out); }
  .sb:hover .cta :global(svg) { transform: translateX(4px); }
  .count { font-size: 0.86rem; opacity: 0.7; white-space: nowrap; }

  /* ── natal: pisca-pisca ── */
  .bulb .cap { fill: #2c3a33; }
  .bulb .glass { fill: var(--c); animation: blink var(--d) steps(1, end) var(--delay) infinite; }
  .bulb .halo { fill: var(--c); opacity: 0.9; animation: halo var(--d) ease-in-out var(--delay) infinite; }
  @keyframes blink { 0%, 62% { filter: brightness(1.25) saturate(1.2); opacity: 1; } 63%, 78% { filter: brightness(0.55); opacity: 0.5; } 79%, 100% { filter: brightness(1.25) saturate(1.2); opacity: 1; } }
  @keyframes halo { 0%, 60% { opacity: 0.9; } 64%, 76% { opacity: 0.06; } 80%, 100% { opacity: 0.9; } }

  /* ── são joão: bandeirinhas ── */
  .flag { transform-origin: 0 0; animation: sway 3.2s ease-in-out var(--sway) infinite; }
  @keyframes sway { 0%, 100% { transform: rotate(-4deg); } 50% { transform: rotate(4deg); } }

  /* ── carnaval: confete e serpentina ── */
  .confetti { inset: 0; }
  .confetti i { position: absolute; width: 7px; height: 4px; background: var(--c); border-radius: 1px; rotate: var(--r); opacity: 0.75; animation: float 6s ease-in-out var(--delay) infinite; }
  .confetti i.round { width: 6px; height: 6px; border-radius: 50%; }
  .streamers { position: absolute; top: 0; left: 0; width: 100%; height: 60px; fill: none; stroke-width: 3; stroke-linecap: round; }
  @keyframes float { 0%, 100% { translate: 0 0; } 50% { translate: 3px 8px; } }

  /* ── halloween: lua, teia e morcegos ── */
  .spooky { inset: 0; }
  .moon { position: absolute; right: 22px; top: 18px; width: 54px; height: 54px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #fff6d8, #ffd27a 70%); box-shadow: 0 0 40px 6px rgba(255, 190, 90, 0.35); }
  .web { position: absolute; left: 0; top: 0; width: 96px; height: 96px; fill: none; stroke: rgba(255, 255, 255, 0.28); stroke-width: 0.8; }
  .bat { position: absolute; width: calc(40px * var(--s)); height: auto; fill: #07030c; animation: flap 0.5s ease-in-out var(--delay) infinite alternate; }
  @keyframes flap { from { transform: scaleY(1); } to { transform: scaleY(0.55); } }

  /* ── genérico: brilhos ── */
  .sparkles { inset: 0; }
  .sparkles svg { position: absolute; width: calc(18px * var(--s)); height: auto; fill: var(--hi); animation: twinkle 2.6s ease-in-out var(--delay) infinite; }
  @keyframes twinkle { 0%, 100% { opacity: 0.25; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1); } }

  @media (prefers-reduced-motion: reduce) {
    .bulb .glass, .bulb .halo, .flag, .confetti i, .bat, .sparkles svg { animation: none !important; }
  }
</style>
