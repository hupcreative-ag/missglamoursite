---
import Icon from './Icon.astro';
import { wa } from '../config/site';
const items = [
  { icon: 'card' as const, q: 'Como eu pago?', a: 'Pix, cartão ou dinheiro. Parcelamento e desconto a gente combina no WhatsApp.' },
  { icon: 'truck' as const, q: 'Quanto é a entrega?', a: 'Depende do bairro. Manda o seu que a gente passa o valor antes de fechar.' },
  { icon: 'clock' as const, q: 'Até que horas chega hoje?', a: 'Pedido até 10h sai no mesmo dia. Depois disso vai no dia seguinte. Se tiver pressa você retira na loja ou chama um Uber Flash.' },
  { icon: 'box' as const, q: 'Tem preço especial pra compra maior?', a: 'Tem valores especiais pra compras maiores. Manda sua lista no WhatsApp que a gente faz o orçamento.' },
  { icon: 'calendar' as const, q: 'Abre domingo?', a: 'Domingo e feriado tem horário especial. Confirma no WhatsApp antes de vir.' },
];
---
<section id="duvidas" class="faq">
  <div class="wrap grid">
    <div>
      <h2 class="display h2" data-split>
        <span class="line-mask"><span>Ficou com dúvida?</span></span>
      </h2>
      <a class="btn btn-wa" href={wa('Oi, Miss! Tenho uma dúvida: ')} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chamar no WhatsApp</a>
    </div>
    <div class="list" data-reveal>
      {items.map((it) => (
        <details data-reveal-item>
          <summary><Icon name={it.icon} class="q-ico" /><span class="q">{it.q}</span><Icon name="plus" /></summary>
          <p>{it.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding: var(--sec-y) 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .h2 { margin-bottom: 20px; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; gap: 14px; min-height: 64px; padding: 14px 0; cursor: pointer; list-style: none; font-size: 1.1rem; font-weight: 500; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { width: 22px; height: 22px; flex: none; transition: transform 0.45s var(--ease-out); }
  summary .q { flex: 1; }
  summary :global(.q-ico) { color: var(--pink-ink); }
  details[open] summary :global(svg:last-child) { transform: rotate(45deg); }
  details p { padding: 0 36px 20px 36px; color: var(--ink-2); max-width: 60ch; }
  summary:hover span { color: var(--teal); }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }
</style>
