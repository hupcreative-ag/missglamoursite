---
import Icon from './Icon.astro';
import { wa } from '../config/site';
import { proLines } from '../config/media';
---
<section id="profissionais" class="pro">
  <div class="wrap">
    <div class="head">
      <h2 class="display h2">Acabou o insumo?</h2>
      <p class="lead">Site de fora demora e ainda cobra frete. Aqui você pede cedo e recebe no mesmo dia.</p>
    </div>

    <ul class="lines" data-reveal>
      {proLines.map((l, i) => (
        <li data-reveal-item>
          <a href={`/profissionais#${l.id}`} class:list={['tile', i % 2 ? 'pink' : 'blue']}>
            <span class="tile-img">{l.img ? <img src={l.img} alt={l.alt} loading="lazy" width="640" height="640" /> : <span class="no-img"><Icon name={l.icon} /></span>}</span>
            <span class="tile-body">
              <span class="t-head"><Icon name={l.icon} /><span class="display t-title">{l.title}</span></span>
              <span class="t-items">{l.items}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="cta" data-reveal>
      <Icon name="list" class="cta-ico" />
      <p class="cta-t display" data-reveal-item>Manda sua lista que a gente separa</p>
      <a class="btn btn-wa" data-reveal-item href={wa('Oi, Miss! Sou profissional e essa é minha lista: ')} target="_blank" rel="noopener">
        <span class="wa-dot" aria-hidden="true"></span> Enviar minha lista
      </a>
    </div>
  </div>
</section>

<style>
  .pro { padding: var(--sec-y) 0; }
  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 32px; align-items: end; margin-bottom: var(--head-gap); }
  .head .lead { justify-self: end; }

  .lines { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .tile { display: flex; flex-direction: column; height: 100%; border-radius: 16px; overflow: hidden; text-decoration: none; color: var(--ink); transition: transform 0.5s var(--ease-out); }
  .tile.blue { background: var(--blue-soft); }
  .tile.pink { background: var(--pink-soft); }
  .tile:hover { transform: translateY(-4px); }
  .tile-img { display: block; aspect-ratio: 4 / 3; overflow: hidden; }
  .tile-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease-out); }
  .tile:hover .tile-img img { transform: scale(1.05); }
  .no-img { display: grid; place-items: center; width: 100%; height: 100%; background: radial-gradient(circle at 50% 45%, #fff 0 30%, transparent 31%); }
  .no-img :global(svg) { width: 34%; height: auto; color: var(--pink-ink); stroke-width: 1.2; }
  .tile-body { display: flex; flex-direction: column; gap: 4px; padding: 14px 16px 18px; }
  .t-head { display: flex; align-items: center; gap: 8px; }
  .t-head :global(svg) { width: 22px; height: 22px; flex: none; color: var(--pink-ink); }
  .t-title { font-size: clamp(1.25rem, 1.8vw, 1.6rem); line-height: 1.05; }
  .t-items { font-size: 0.95rem; color: var(--ink-2); }

  .cta {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px 20px;
    margin-top: clamp(16px, 2vw, 24px); padding: clamp(18px, 2.4vw, 28px) clamp(20px, 2.6vw, 32px);
    border-radius: 16px; background: var(--ink); color: #fff;
  }
  .cta :global(.cta-ico) { width: 30px; height: 30px; color: var(--blue); }
  .cta-t { font-size: clamp(1.4rem, 2.2vw, 1.9rem); line-height: 1.05; }
  .cta .btn-wa { background: #fff; color: var(--ink); box-shadow: none; }
  .cta .btn-wa:hover { background: var(--blue); }

  @media (max-width: 860px) {
    .head { grid-template-columns: 1fr; }
    .head .lead { justify-self: start; }
    .lines { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .tile-img { aspect-ratio: 1; }
    .tile-body { padding: 10px 12px 14px; }
    .t-title { font-size: 1.15rem; }
    .t-items { font-size: 0.875rem; line-height: 1.35; }
    .t-head :global(svg) { width: 18px; height: 18px; }
    .cta { grid-template-columns: auto 1fr; }
    .cta .btn { grid-column: 1 / -1; width: 100%; }
  }
</style>
