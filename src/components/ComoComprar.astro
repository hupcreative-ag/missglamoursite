---
import Icon from './Icon.astro';
import ClayIcon from './ClayIcon.astro';
import { wa, store } from '../config/site';

const modes = [
  { icon: 'box' as const, title: 'Entrega no mesmo dia', text: 'Pedido até 10h chega hoje' },
  { icon: 'bolt' as const, title: 'Uber Flash', text: 'Você chama pelo app e sai na hora' },
  { icon: 'bag' as const, title: 'Retirada na loja', text: 'A gente deixa tudo separado' },
];
const pays = [
  { icon: 'pix' as const, label: 'Pix' },
  { icon: 'card' as const, label: 'Cartão' },
  { icon: 'cash' as const, label: 'Dinheiro' },
];
---
<section id="como-comprar" class="how">
  <div class="wrap">
    <div class="head">
      <h2 class="display h2">Como você recebe</h2>
    </div>

    <ul class="modes" data-reveal>
      {modes.map((m) => (
        <li data-reveal-item>
          <ClayIcon name={m.icon} class="ico" />
          <div>
            <h3 class="display">{m.title}</h3>
            <p>{m.text}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="foot" data-reveal>
      <div class="row" data-reveal-item>
        <p class="k">Entregamos em</p>
        <ul class="chips">{store.deliveryAreas.map((a) => <li><Icon name="pin" />{a}</li>)}</ul>
      </div>
      <div class="row" data-reveal-item>
        <p class="k">Você paga com</p>
        <ul class="chips">{pays.map((p) => <li><Icon name={p.icon} />{p.label}</li>)}</ul>
      </div>
      <a class="btn btn-wa" data-reveal-item href={wa('Oi, Miss! Quanto fica a entrega pro meu bairro? ')} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Ver a taxa do meu bairro
      </a>
    </div>
  </div>
</section>

<style>
  .how { padding: var(--sec-y) 0; background: var(--mist); }
  .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; margin-bottom: var(--head-gap); }

  .modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
  .modes li { display: flex; flex-direction: column; gap: 14px; padding: clamp(20px, 2.4vw, 32px); border-radius: 16px; background: #fff; }
  .modes :global(.ico) { width: clamp(64px, 6vw, 88px); }
  .modes h3 { font-size: clamp(1.4rem, 2vw, 1.75rem); line-height: 1.05; }
  .modes p { color: var(--ink-2); margin-top: 4px; }

  .foot { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 36px; margin-top: clamp(28px, 3.4vw, 44px); }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
  .k { font-size: 0.95rem; color: var(--ink-3); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 14px; border-radius: 999px; background: #fff; font-weight: 500; font-size: 0.95rem; }
  .chips :global(svg) { width: 18px; height: 18px; color: var(--pink-ink); }
  .foot .btn { margin-left: auto; }

  @media (max-width: 860px) {
    .modes { grid-template-columns: 1fr; gap: 10px; }
    .modes li { flex-direction: row; align-items: center; gap: 16px; padding: 14px 18px; }
    .modes :global(.ico) { width: 60px; flex: none; }
    .modes h3 { font-size: 1.35rem; }
    .modes p { font-size: 0.98rem; }
    .foot { flex-direction: column; align-items: stretch; gap: 16px; }
    .row { flex-direction: column; align-items: flex-start; gap: 8px; }
    .foot .btn { margin-left: 0; width: 100%; }
  }
</style>
