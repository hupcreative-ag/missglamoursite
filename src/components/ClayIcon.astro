---
/**
 * Ícones de destaque em estilo 3D/clay, na paleta do mascote (azul, rosa, branco e dourado).
 * Usar no máximo nos pontos-chave: formas de receber e selo de entrega.
 */
interface Props { name: 'box' | 'bolt' | 'bag'; class?: string }
const { name, class: cls } = Astro.props;
const id = `ci-${name}`;
---
<svg class:list={['clay', cls]} viewBox="0 0 120 120" aria-hidden="true">
  <defs>
    <linearGradient id={`${id}-a`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e6f8fb" /><stop offset="1" stop-color="#b4e3ec" /></linearGradient>
    <linearGradient id={`${id}-b`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#8fd0dd" /><stop offset="1" stop-color="#5aaebf" /></linearGradient>
    <linearGradient id={`${id}-c`} x1="1" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#a6dce7" /><stop offset="1" stop-color="#76c1d0" /></linearGradient>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ffe7b8" /><stop offset="0.5" stop-color="#f5c76a" /><stop offset="1" stop-color="#d99a32" /></linearGradient>
    <linearGradient id={`${id}-p`} x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f6a3c0" /><stop offset="1" stop-color="#d4567f" /></linearGradient>
  </defs>
  <ellipse cx="60" cy="108" rx="34" ry="6" fill="rgba(32,35,40,0.12)" />

  {name === 'box' && (
    <g>
      <polygon points="20,40 60,60 60,104 20,84" fill={`url(#${id}-b)`} />
      <polygon points="60,60 100,40 100,84 60,104" fill={`url(#${id}-c)`} />
      <polygon points="60,20 100,40 60,60 20,40" fill={`url(#${id}-a)`} />
      <polygon points="35.6,27.4 43.6,31.4 83.6,51.4 75.6,47.4" fill="#f08cae" />
      <polygon points="75.6,47.4 83.6,51.4 83.6,95.4 75.6,91.4" fill="#d4567f" />
      <polyline points="20,40 60,20 100,40" fill="none" stroke="#fff" stroke-width="2.4" stroke-linejoin="round" opacity="0.9" />
      <line x1="60" y1="60" x2="60" y2="104" stroke="#fff" stroke-width="1.8" opacity="0.5" />
    </g>
  )}

  {name === 'bolt' && (
    <g>
      <polygon points="69,12 33,66 58,66 48,110 92,48 66,48 79,12" fill="#c98a2a" transform="translate(6 5)" />
      <polygon points="69,12 33,66 58,66 48,110 92,48 66,48 79,12" fill={`url(#${id}-g)`} />
      <polyline points="33,66 69,12 79,12" fill="none" stroke="#fff6e0" stroke-width="2.6" stroke-linejoin="round" opacity="0.95" />
      <path d="M56 30 l2.5 6.5 6.5 2.5 -6.5 2.5 -2.5 6.5 -2.5 -6.5 -6.5 -2.5 6.5 -2.5z" fill="#fff" opacity="0.9" transform="translate(-30 8) scale(0.9)" />
    </g>
  )}

  {name === 'bag' && (
    <g>
      <polygon points="86,42 98,35 98,96 86,104" fill="#5aaebf" />
      <rect x="24" y="42" width="62" height="62" rx="4" fill={`url(#${id}-c)`} />
      <polygon points="24,42 86,42 98,35 36,35" fill={`url(#${id}-a)`} />
      <path d="M42 44 C42 16, 68 16, 68 44" fill="none" stroke="#3f8796" stroke-width="5" stroke-linecap="round" transform="translate(1.5 1.5)" opacity="0.5" />
      <path d="M42 44 C42 16, 68 16, 68 44" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" />
      <ellipse cx="46" cy="58" rx="10" ry="6.5" fill={`url(#${id}-p)`} transform="rotate(-18 46 58)" />
      <ellipse cx="64" cy="58" rx="10" ry="6.5" fill={`url(#${id}-p)`} transform="rotate(18 64 58)" />
      <circle cx="55" cy="60" r="5" fill="#c2477a" />
      <path d="M52 64 l-5 13 M58 64 l5 13" stroke="#d4567f" stroke-width="4" stroke-linecap="round" />
      <rect x="28" y="46" width="6" height="40" rx="3" fill="#fff" opacity="0.35" />
    </g>
  )}
</svg>

<style>
  .clay { display: block; width: 100%; height: auto; overflow: visible; }
</style>
