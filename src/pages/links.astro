---
/**
 * LINK DA BIO · missglamour.com.br/links  (também /bio e /linktree, ver public/_redirects)
 * Substitui o Linktree. Ordem: banner da campanha (só quando tem catálogo ligado),
 * banner do site e os links que estavam no Linktree (WhatsApp, loja/avaliação, Instagram).
 * O banner da campanha liga e desliga sozinho por src/config/site.ts (activeSeason + showCatalog).
 */
import '../styles/global.css';
import Head from '../components/Head.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import BioSeasonBanner from '../components/BioSeasonBanner.astro';
import { store, wa } from '../config/site';
import { season, catalog } from '../seasons';

const instagram = `https://instagram.com/${store.instagram}`;
const whatsapp = wa('Oi, Miss! Vim pelo Instagram e quero fazer um pedido.');
---
<!doctype html>
<html lang="pt-BR" class="bio-html">
  <head>
    <Head
      title="Miss Glamour | WhatsApp, loja e catálogo"
      description="Links da Miss Glamour: compre pelo WhatsApp, veja o catálogo da temporada, conheça o site e visite a loja na Av. Sete de Setembro, centro de Salvador."
      noindex
    />
  </head>
  <body data-season={season?.theme ?? 'base'}>
    <main class="bio">
      <header class="top" style="--i:0">
        <h1><Logo tagline /></h1>
        <p class="about">Sua loja de beleza e decoração na Avenida 7</p>
        <p class="status"><span class="live-dot" data-state="closed"></span><span data-live="store">Seg a sex 8h às 18h · Sáb 8h às 16h</span></p>
        <nav class="social" aria-label="Redes">
          <a href={instagram} target="_blank" rel="noopener" aria-label="Instagram @missglamourav7"><Icon name="instagram" /></a>
          <a href={whatsapp} target="_blank" rel="noopener" aria-label={`WhatsApp ${store.whatsappLabel}`}><Icon name="whatsapp" /></a>
        </nav>
      </header>

      {season && catalog && (
        <div class="item" style="--i:1"><BioSeasonBanner season={season} catalog={catalog} /></div>
      )}

      <a class="item site" href="/" style="--i:2">
        <span class="site-photo">
          <img src="/img/loja/placa.webp" alt="Fachada da Miss Glamour na Avenida Sete de Setembro" width="1000" height="1333" loading="eager" />
        </span>
        <span class="site-body">
          <img class="mascot" src="/img/mascote-busto-sm.webp" alt="" width="520" height="529" />
          <span class="site-copy">
            <span class="site-title display">Conheça a loja completa</span>
            <span class="site-text">Insumos de beleza, acessórios e decoração num lugar só</span>
          </span>
        </span>
        <span class="site-cta">
          <span>missglamour.com.br</span>
          <Icon name="arrow" />
        </span>
      </a>

      <ul class="links">
        <li class="item" style="--i:3">
          <a class="link primary" href={whatsapp} target="_blank" rel="noopener">
            <span class="ic"><Icon name="whatsapp" /></span>
            <span class="lt">
              <span class="t">Compre agora pelo WhatsApp</span>
              <span class="s" data-live="delivery" data-variant="short">Pedido até 10h chega no mesmo dia</span>
            </span>
            <Icon name="arrow" class="go" />
          </a>
        </li>
        <li class="item" style="--i:4">
          <a class="link" href={store.mapsUrl} target="_blank" rel="noopener">
            <span class="ic"><Icon name="pin" /></span>
            <span class="lt">
              <span class="t">Visite nossa loja</span>
              <span class="s">{store.address.street.split(' - ')[0]} · Faça sua avaliação</span>
            </span>
            <Icon name="arrow" class="go" />
          </a>
        </li>
        <li class="item" style="--i:5">
          <a class="link" href={instagram} target="_blank" rel="noopener">
            <span class="ic"><Icon name="instagram" /></span>
            <span class="lt">
              <span class="t">Acesse nosso Instagram</span>
              <span class="s">@{store.instagram}</span>
            </span>
            <Icon name="arrow" class="go" />
          </a>
        </li>
      </ul>

      <footer class="ft item" style="--i:6">
        <p>Seg a sex 8h às 18h · Sáb 8h às 16h</p>
        <p>{store.address.street} - {store.address.district}, {store.address.city} - {store.address.state}</p>
      </footer>
    </main>

    <script>
      import '../scripts/status.ts';
    </script>
  </body>
</html>

<style>
  :global(html.bio-html) { background: var(--blue); }
  :global(body) { background: var(--blue); }

  .bio {
    width: 100%;
    max-width: 480px;
    margin-inline: auto;
    padding: 40px 16px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* entrada em cascata, curta (quem vem da bio quer clicar) */
  .top, .item { animation: rise 0.7s var(--ease-out) both; animation-delay: calc(var(--i) * 70ms); }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } }

  /* ── topo ── */
  .top { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; margin-bottom: 10px; }
  h1 { font-weight: 400; color: var(--ink); }
  h1 :global(.logo-word) { font-size: 2rem; padding-bottom: 8px; }
  h1 :global(.logo-tag) { font-size: 0.92rem; margin-top: 8px; }
  .about { color: var(--ink-2); font-size: 1rem; }
  .status {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 6px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.55);
    font-size: 0.86rem; color: var(--ink-2);
  }
  .social { display: flex; gap: 10px; }
  .social a {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%;
    color: var(--ink); transition: background 0.3s, transform 0.4s var(--ease-out);
  }
  .social a:hover { background: rgba(255, 255, 255, 0.6); transform: translateY(-2px); }
  .social :global(svg) { width: 24px; height: 24px; }

  /* ── banner do site ── */
  .site {
    display: block; position: relative; overflow: hidden;
    border-radius: 22px; background: var(--paper); color: var(--ink); text-decoration: none;
    box-shadow: var(--shadow-1);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .site:hover { transform: translateY(-3px); box-shadow: var(--shadow-2); }
  .site:active { transform: scale(0.985); }
  .site-photo { display: block; height: 150px; overflow: hidden; }
  .site-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; transition: transform 1.2s var(--ease-out); }
  .site:hover .site-photo img { transform: scale(1.04); }
  .site-body { display: grid; grid-template-columns: 108px 1fr; align-items: end; gap: 12px; padding: 0 20px 0 10px; }
  .mascot { width: 118px; margin-top: -58px; position: relative; filter: drop-shadow(0 10px 14px rgba(20, 30, 40, 0.18)); }
  .site-copy { display: flex; flex-direction: column; gap: 4px; padding-top: 14px; }
  .site-title { font-size: 1.6rem; line-height: 1.02; }
  .site-text { font-size: 0.92rem; line-height: 1.35; color: var(--ink-3); }
  .site-cta {
    display: flex; align-items: center; justify-content: space-between;
    margin: 14px 14px 14px; padding: 0 20px; height: 52px; border-radius: 999px;
    background: var(--ink); color: #fff; font-weight: 500;
  }
  .site-cta :global(svg) { width: 20px; height: 20px; transition: transform 0.4s var(--ease-out); }
  .site:hover .site-cta { background: var(--pink-ink); }
  .site:hover .site-cta :global(svg) { transform: translateX(4px); }

  /* ── links do Linktree ── */
  .links { display: flex; flex-direction: column; gap: 10px; margin-top: 4px; }
  .link {
    display: flex; align-items: center; gap: 14px; min-height: 68px; padding: 10px 18px 10px 10px;
    border-radius: 999px; background: var(--paper); color: var(--ink); text-decoration: none;
    box-shadow: 0 1px 2px rgba(20, 30, 40, 0.06);
    transition: transform 0.4s var(--ease-out), background 0.3s, box-shadow 0.4s var(--ease-out);
  }
  .link:hover { transform: translateY(-2px); box-shadow: var(--shadow-1); }
  .link:active { transform: scale(0.98); }
  .ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--mist); color: var(--teal); flex: none; }
  .ic :global(svg) { width: 22px; height: 22px; }
  .lt { display: flex; flex-direction: column; min-width: 0; flex: 1; }
  .t { font-weight: 500; line-height: 1.25; }
  .s { font-size: 0.84rem; color: var(--ink-3); line-height: 1.3; }
  .link :global(.go) { width: 20px; height: 20px; flex: none; color: var(--ink-3); transition: transform 0.4s var(--ease-out); }
  .link:hover :global(.go) { transform: translateX(3px); }

  .primary { background: var(--ink); color: #fff; box-shadow: 0 12px 30px -14px rgba(20, 30, 40, 0.6); }
  .primary:hover { background: #2c3138; }
  .primary .ic { background: #25d366; color: #fff; }
  .primary .s { color: rgba(255, 255, 255, 0.72); }
  .primary :global(.go) { color: rgba(255, 255, 255, 0.8); }

  .ft { text-align: center; font-size: 0.8rem; color: var(--ink-2); margin-top: 14px; display: flex; flex-direction: column; gap: 2px; }

  @media (min-width: 560px) {
    .bio { padding-top: 64px; }
    .site-photo { height: 180px; }
  }
</style>
