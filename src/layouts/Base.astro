---
import '../styles/global.css';
import { season } from '../seasons';
import Head from '../components/Head.astro';
import Ribbon from '../components/Ribbon.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props { title: string; description: string; image?: string; imageAlt?: string; noindex?: boolean }
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <Head {...Astro.props} />
    <slot name="head" />
  </head>
  <body data-season={season?.theme ?? 'base'}>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    {season && <Ribbon {...season.ribbon} />}
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/status.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 10px; }
  .skip:focus { top: 12px; }
</style>
