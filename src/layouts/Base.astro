---
import '../styles/global.css';
import { store, wa, fullAddress } from '../config/site';
import { season } from '../seasons';
import Ribbon from '../components/Ribbon.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props { title: string; description: string; image?: string }
const { title, description, image = '/img/loja/placa.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, store.url).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  '@id': `${store.url}/#loja`,
  name: store.name,
  slogan: store.tagline,
  url: store.url,
  image: new URL(image, store.url).toString(),
  telephone: '+55 71 99628-5221',
  priceRange: '$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${store.address.street} - ${store.address.district}`,
    postalCode: store.address.postalCode,
    addressLocality: store.address.city,
    addressRegion: store.address.state,
    addressCountry: 'BR',
  },
  areaServed: store.deliveryAreas.map((name) => ({ '@type': 'City', name })),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '08:00', closes: '16:00' },
  ],
  sameAs: [`https://instagram.com/${store.instagram}`],
  paymentAccepted: 'Pix, cartão de crédito, cartão de débito, dinheiro',
  hasMap: store.mapsUrl,
  geo: { '@type': 'GeoCoordinates', latitude: store.geo.lat, longitude: store.geo.lng },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Insumos de beleza',
    itemListElement: ['Nail design', 'Lash design', 'Sobrancelha', 'Maquiagem', 'Depilação'].map((name) => ({ '@type': 'OfferCatalog', name })),
  },
};
const storeConfig = { hours: store.hours, cutoff: store.sameDayCutoff };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#97d3e0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, store.url).toString()} />
    <meta name="geo.region" content="BR-BA" />
    <meta name="geo.placename" content="Salvador" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
    <script id="store-config" type="application/json" set:html={JSON.stringify(storeConfig)} />
  </head>
  <body data-season={season?.theme ?? 'base'}>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    {season && <Ribbon {...season.ribbon} />}
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <MobileBar />
    <script>
      import '../scripts/status.ts';
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 100; background: var(--ink); color: #fff; padding: 10px 16px; border-radius: 10px; }
  .skip:focus { top: 12px; }
</style>
